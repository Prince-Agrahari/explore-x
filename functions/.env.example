# Server-only Gemini key. Never prefix this with VITE_.
# Create a key at https://aistudio.google.com/apikey
# Local: copy this file to functions/.env (gitignored) and paste the key.
# If Google reports the key as leaked, create a NEW key and restart `npm run dev`.
# Production: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=

# Optional model override. Default tries gemini-3.6-flash, then fallbacks.
# GEMINI_MODEL=gemini-3.6-flash
