# Public Firebase web config for the React client.
# These values identify the project; they are not a substitute for
# Firestore rules, Auth restrictions, or API key restrictions.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional: set to true only when the Functions emulator is running.
# VITE_USE_FUNCTIONS_EMULATOR=true

# Do not put GEMINI_API_KEY in this file or any VITE_ variable.
# Store it as a Cloud Functions secret. See functions/.env.example.
