# Frontend / public Firebase web config (safe to expose in the Vite client).
# These identify the Firebase project. They are not a substitute for
# Firestore rules, Auth settings, or API key restrictions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Set to true only when the Functions emulator is running.
# VITE_USE_FUNCTIONS_EMULATOR=true

# SERVER-ONLY. Never prefix with VITE_. Never add this to Vercel/frontend env.
# Local: put the real value in functions/.env, not in the Vite client.
# Production: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=
